# Șablon pentru .env de pe server (docker-compose.yml). Copiază în .env și
# completează; .env NU intră în git și are drepturi 660 (grupul proj-cai-cadre).
#   cp .env.example .env && chmod 660 .env

# --- Baza de date ---
# Două roluri, două parole (ambele lungi și aleatoare):
#   python3 -c "import secrets; print(secrets.token_urlsafe(30))"
# `caicadre` — superuserul bazei: copii de siguranță, administrare. NU îl
# folosește aplicația.
POSTGRES_PASSWORD=
# `caicadre_app` — rolul aplicației, fără superuser (deploy/db/10-app-role.sh îl
# creează la prima pornire a bazei; dacă schimbi parola aici după aceea,
# schimb-o și în bază: docker compose exec db psql -U caicadre -c "ALTER ROLE caicadre_app PASSWORD '…'")
APP_DB_PASSWORD=
# câte zile se păstrează copiile din ./backups
BACKUP_KEEP_DAYS=14

# --- Fusul orar al containerelor (jurnale, cron, ore pe ecrane) ---
TZ=Europe/Chisinau

# --- Reverse proxy / tunel ---
# Portul de pe localhost pe care nginx îl publică pentru verificări locale.
# Pe acest server sunt deja ocupate (2026-11-17): 3000, 3010, 3020, 3030, 3040,
# 3100, 3200, 3300, 3400, 3500, 3600, 3700, 3800, 3900, 3950, 4000, 4100-4103,
# 5432, 5433, 5440, 6379, 8080-8082, 2283.
NGINX_PORT=3960
# Tokenul conectorului tunelului Cloudflare (îl are doar Ion, din panoul
# Cloudflare). Gol = stiva pornește fără `cloudflared` (doar local, pe
# 127.0.0.1:NGINX_PORT); cu token, profilul `tunnel` se activează singur
# prin rândul COMPOSE_PROFILES de mai jos — nu-l șterge.
# Ruta publică a tunelului: cai-cadre.integratii.md → http://cai-cadre-web:80
TUNNEL_TOKEN=
COMPOSE_PROFILES=${TUNNEL_TOKEN:+tunnel}

# --- Aplicația (serviciul `app`) ---
# Cheia aplicației: min. 40 de caractere aleatoare; aplicația refuză să
# pornească cu o cheie lipsă, scurtă sau care conține „insecure”/„change-me”.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Originile publice ale aplicației (virgulă între ele): hostname-urile permise
# și originile de încredere pentru CSRF. Până la tunel, pe server:
#   APP_ORIGINS=http://127.0.0.1:3960
# Cu tunelul: https://cai-cadre.integratii.md
APP_ORIGINS=
# Parola consolei platformei CAI CADRE (/__platform/console: starea serverului,
# bazele), cel puțin 8 caractere:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CRM_CONSOLE_PASSWORD=
